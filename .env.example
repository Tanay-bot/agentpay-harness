# =============================================================================
# agentpay-harness — Environment Configuration
# =============================================================================
# Copy this file to .env, fill in your Stripe **test-mode** key, and export it
# (e.g. `set -a; source .env; set +a`). The harness reads environment
# variables only; it does not load .env files itself.
#
# With no key set, the harness runs fully offline against its built-in mock.
#
# ⚠️  NEVER use live-mode keys (sk_live_*).  The harness will refuse to start
#     if it detects a live key.
# =============================================================================

# Your Stripe test-mode secret key (starts with sk_test_)
STRIPE_TEST_SECRET_KEY=sk_test_REPLACE_ME
# (STRIPE_API_KEY is accepted as a fallback name.)

# To target stripe-mock, pass the URL on the command line instead:
#   agentpay run scenarios/ --base-url http://localhost:12111
