# =============================================================================
# agentpay-harness — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your Stripe **test-mode** credentials.
#
# ⚠️  NEVER use live-mode keys (sk_live_*).  The harness will refuse to start
#     if it detects a live key.
# =============================================================================

# Your Stripe test-mode secret key (starts with sk_test_)
STRIPE_TEST_SECRET_KEY=sk_test_REPLACE_ME

# Webhook signing secret for local endpoint verification (starts with whsec_test_)
STRIPE_WEBHOOK_SECRET=whsec_test_REPLACE_ME

# Optional: override the Stripe API base URL (e.g., for stripe-mock)
# STRIPE_API_BASE=http://localhost:12111
